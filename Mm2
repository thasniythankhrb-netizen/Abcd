-- Logic ตรวจจับการเริ่มเกม + จับเวลา 3 นาที
local roundStartTime = nil
local inRound = false

local function CheckGameStarted()
    local coinContainer = Workspace:FindFirstChild("Normal") or Workspace:FindFirstChild("Container")
    local hasCoins = coinContainer and coinContainer:FindFirstChild("CoinContainer") and #coinContainer.CoinContainer:GetChildren() > 0
    
    local hasRoleInGame = false
    for _, plr in pairs(Players:GetPlayers()) do
        if GetPlayerRole(plr) ~= "Innocent" then
            hasRoleInGame = true
            break
        end
    end

    return hasCoins or hasRoleInGame
end

task.spawn(function()
    while task.wait(0.1) do
        if _G.ShowTimer then
            local isGameActive = CheckGameStarted()

            if isGameActive then
                if not inRound then
                    inRound = true
                    roundStartTime = tick()
                end

                local elapsed = tick() - roundStartTime
                local timeLeft = math.max(0, 180 - math.floor(elapsed))

                local m = math.floor(timeLeft / 60)
                local s = math.floor(timeLeft % 60)
                TimerLabel.Text = string.format("⏱️ show round time (จับเวลาจบเกม): %02d:%02d", m, s)
                
                if timeLeft <= 30 then
                    TimerLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                else
                    TimerLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                end
            else
                inRound = false
                roundStartTime = nil
                TimerLabel.Text = "⏱️ รอเริ่มรอบใหม่..."
                TimerLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
            end
        end
    end
end)

